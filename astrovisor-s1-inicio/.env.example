# API local (la configuración real va en el entorno)
PORT=3001
# No guardar credenciales o claves de producción en este archivo.

# S4: ruta absoluta privada FUERA del checkout y de toda raíz pública.
# Configurar en el entorno real y ejecutar npm run init:catalogo una sola vez.
# ASTROVISOR_DATA_DIR=

# Etapa 2A: archivo JSON privado externo al checkout; contiene solo hash/sal.
# Generar desde terminal interactiva con npm run configurar:admin, sin argumentos.
# ASTROVISOR_ADMIN_FILE=
